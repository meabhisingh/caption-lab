{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaptionLab",
  "version": "0.2.0",
  "identifier": "com.captionlab.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://127.0.0.1:43110",
    "beforeDevCommand": "node ../scripts/dev-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CaptionLab",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 700,
        "backgroundColor": "#08080a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/web/**/*", "resources/backend/**/*"]
  }
}
